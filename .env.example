# QwantomHub Talent Pipeline Platform — Master Environment Variables Template

# -----------------------------------------------------------------------------
# 1. Auth (Service 2: Clerk Authentication & RBAC)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# 2. Database & Storage (Drizzle ORM, Supabase Postgres & Storage)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/qpipeline
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # Server-only! Never expose to client!
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=qpipeline-media

# -----------------------------------------------------------------------------
# 3. Notifications (Service 4: Termii SMS/WhatsApp & Brevo Email)
# -----------------------------------------------------------------------------
TERMII_API_KEY=TLxxxxxxxxxxxxxxxxxxxxxxxx
TERMII_SENDER_ID=QwantomHub
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=no-reply@qwantomhub.com
BREVO_SENDER_NAME="QwantomHub Pipeline"
NOTIFICATIONS_MOCK_MODE=false # Set to false in production for real dispatch

# -----------------------------------------------------------------------------
# 4. AI & Coding Assessment (Service 9, 10, 11: Anthropic, GitHub & Webhooks)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx
GITHUB_CODESPACES_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
QPIPELINE_WEBHOOK_SECRET=qpipeline_webhook_secret_dev # Internal HMAC secret for GitHub Actions grading webhooks

# -----------------------------------------------------------------------------
# 5. Local Channel Payout Disbursement (Service 18, 19, 21: Paystack API)
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 6. Contract & Onboarding E-Signature (Service 22: Documenso & Security)
# -----------------------------------------------------------------------------
DOCUMENSO_HOST_URL=https://app.documenso.com # Or self-hosted Documenso instance URL
DOCUMENSO_API_KEY=documenso_api_key_xxxxxxxxxxxxxxxx
DOCUMENSO_WEBHOOK_SECRET=whsec_documenso_xxxxxxxxxxxxxxxx
CONTRACT_HMAC_SECRET=qwantomhub_contract_security_secret_key_2026 # Secret key for SHA-256 contract seals

# =============================================================================
# 7. Phase 4 Pending External Services (Services 26–29) — Pending Credentials
# =============================================================================

# Service 26: Deel API (Payroll & EOR Display)
DEEL_API_TOKEN=deel_api_token_xxxxxxxxxxxxxxxx
DEEL_ENVIRONMENT=sandbox # sandbox or production

# Service 27: Seelicongate Partner Integration (Bootcamp Payment Sync)
SEELICONGATE_API_KEY=seelicon_api_key_xxxxxxxxxxxxxxxx
SEELICONGATE_WEBHOOK_SECRET=whsec_seelicon_xxxxxxxxxxxxxxxx

# Service 28: Loan Partner Integration (ISA / Financing Display)
LOAN_PARTNER_API_KEY=loan_partner_key_xxxxxxxxxxxxxxxx
LOAN_PARTNER_ENDPOINT=https://api.loanpartner.com/v1

# Service 29: Work-Tool Notification Mirroring
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
JIRA_HOST=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=admin@qwantomhub.com
JIRA_API_TOKEN=jira_token_xxxxxxxxxxxxxxxx
CALENDLY_API_TOKEN=calendly_token_xxxxxxxxxxxxxxxx
